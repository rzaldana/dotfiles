#!/usr/bin/env bash
# 
# Script for creating Atlantis webhooks on Bitbucket Cloud 

set -euo pipefail
source std.bash
source log.bash
source opts.bash

declare -a ATLANTIS_WEBHOOK_EVENTS=(
  "pullrequest:approved"
  "pullrequest:created"
  "pullrequest:comment_created"
  "pullrequest:fulfilled"
  "repo:push"
  "pullrequest:rejected"
  "pullrequest:unapproved"
  "pullrequest:updated"
)
declare ATLANTIS_WEBHOOK_DESCRIPTION="atlantis"

declare -g REPO_SLUG
declare -g __LOG_LEVEL
opts::add_name "$(std::script_name)"
opts::add_description "Creates an atlantis webhook in the Bitbucket project with the given slug"
opts::add_opt_with_arg "l" "LOG_LEVEL" "__LOG_LEVEL" "log level (valid values: off, fatal, error, warn, info, debug"
opts::add_required_arg "REPO_SLUG" "REPO_SLUG"
opts::parse "$@"

if [[ -v __LOG_LEVEL ]]; then
  log::set_level "$__LOG_LEVEL"
fi
WORKSPACE="cifinancial"

# Check if repo exists
if ! bkt repo view --repo "$REPO_SLUG" --workspace "$WORKSPACE" >/dev/null 2>&1 ; then
  std::error "repo not found: $REPO_SLUG"
fi

# Check if repo already has a webhook with the description "atlantis"
if \
  bkt webhook list --repo platform-network --json \
  | jq --raw-output --monochrome-output '.webhooks[].description' \
  | grep --quiet --extended-regexp "^${ATLANTIS_WEBHOOK_DESCRIPTION}$"; then
  log::log WARN "webhook with description '$ATLANTIS_WEBHOOK_DESCRIPTION' already exists. Skipping creation"
  exit 0
fi

# Retrieve atlantis secret
SECRET_DATA="$(aws secretsmanager get-secret-value --secret-id "cloud/pipeline/atlantis")"
WEBHOOK_SECRET="$( jq \
  --exit-status \
  --raw-output \
  --monochrome-output \
  '.SecretString | fromjson | .bitbucket.secret' \
  <<<"$SECRET_DATA"
)"
PAYLOAD="$( echo "{}" \
  | jq --arg description "$ATLANTIS_WEBHOOK_DESCRIPTION" '.description = $description' \
  | jq '.url = "https://atlantis.ci.com/events"' \
  | jq '.active = true' \
  | jq --arg secret "$WEBHOOK_SECRET" '.secret=$secret' \
  | jq '.events = []' \
)"
log::log debug "payload=$PAYLOAD"
for webhook_event in "${ATLANTIS_WEBHOOK_EVENTS[@]}"; do
  PAYLOAD="$( jq --arg event "$webhook_event" '.events += [$event]' <<<"$PAYLOAD" )"
done
log::log debug "payload=$PAYLOAD"

if ! bkt api --method POST --input "$PAYLOAD" "/repositories/$WORKSPACE/$REPO_SLUG/hooks" >/dev/null 2>&1; then
  std::error "Unable to create bitbucket webhook for repo: $REPO_SLUG'"
else
  printf "%s\n" "SUCCESS: Created atlantis webhook for repo: $REPO_SLUG"
fi
