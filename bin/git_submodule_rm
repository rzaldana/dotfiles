#!/usr/bin/env bash


set -euo pipefail

source std.bash

function main() {
  local usage
  read -r -d "" usage <<EOF || :
Removes the git submodule(s) at the given path(s) from the current git repository

Usage: $(std::script_name) [options] [--] <submodule_path>...

Options:
  -h        show help message 

Use "$(std::script_name) -h" to show this help message.
EOF

  std::set_log_level "warn"
  while getopts ":hl:" opt; do
    case "$opt" in
      h)
        printf "%s\n" "$usage"
        exit 0
        ;;
      l)
        std::set_log_level "$OPTARG"
        ;;
      ?)
        printf "%s\n" "$0: invalid option -- $OPTARG"
        printf "%s\n" "See '$0 -h' for usage"
        exit 1
        ;;
    esac
  done
  shift $((OPTIND-1))

  if (( $# > 0 )); then
    for arg in "$@"; do
      std::log "info" "processing submodule $arg"
      remove_submodule "$arg"
    done
  else
    printf "%s\n" "$usage"
  fi
}


function remove_submodule() {
  local submodule_path
  submodule_path="${1}"
  local git_root_dir

  # Check if submodule dir exists
  if ! [[ -d "$submodule_path" ]]; then
    std::error "submodule directory does not exist: $submodule_path"
  fi

  git_root_dir="$(git rev-parse --show-toplevel)"
  std::log "debug" "resolved git root path to $git_root_dir"
  submodule_path_rel_to_git_root="$(realpath --relative-to="$git_root_dir" --canonicalize-existing "$submodule_path")"
  std::log "debug" "resolved submodule path relative to git root to '$submodule_path_rel_to_git_root'"

  # find .gitmodules file
  local git_modules_file_path
  git_modules_file_path="${git_root_dir}/.gitmodules"
  if ! [[ -f "$git_modules_file_path" ]]; then
    std::error "gitmodules file not found at $git_modules_file_path"
  else
    std::log "debug" "found gitmodules file at $git_modules_file_path"
  fi

  # find submodule in gitmodules file
  yq \
    --input-format ini \
    --output-format ini \
    --exit-status \
    '.["submodule \"'"$submodule_path_rel_to_git_root"'\""]' \
    "$git_modules_file_path" >/dev/null 2>&1 \
    || std::error "submodule '$submodule_path_rel_to_git_root' not found in .gitmodules file"

  # find .git/config file
  local git_config_file_path
  git_config_file_path="${git_root_dir}/.git/config"
  if ! [[ -f "$git_config_file_path" ]]; then
    std::error "git config file not found at $git_config_file_path"
  else
    std::log "debug" "found git config file at $git_config_file_path"
  fi


  # find submodule in git config file
  yq \
    --input-format ini \
    --output-format ini \
    --exit-status \
    '.["submodule \"'"$submodule_path_rel_to_git_root"'\""]' \
    "$git_config_file_path" >/dev/null 2>&1 \
    || std::error "submodule '$submodule_path_rel_to_git_root' not found in .git/config file"

  # delete submodule from gitmodules file
  yq \
    --input-format ini \
    --output-format ini \
    --exit-status \
    --inplace \
    'del(.["submodule \"'"$submodule_path_rel_to_git_root"'\""])' \
    "$git_modules_file_path" >/dev/null

  # stage changes to gitmodules file
  git add "$git_modules_file_path"

  # delete submodule form .git/config file
  yq \
    --input-format ini \
    --output-format ini \
    --exit-status \
    --inplace \
    'del(.["submodule \"'"$submodule_path_rel_to_git_root"'\""])' \
    "$git_config_file_path" >/dev/null

  # git rm submodule dir
  git rm --cached "$submodule_path"
  
  # rm submodule directory from .git directory
  rm -rf "$git_root_dir/.git/modules/$submodule_path_rel_to_git_root"

  # commit changes
  git commit -m "remove submodule $submodule_path_rel_to_git_root"

  # remove submodule dir
  rm -rf "$git_root_dir/$submodule_path_rel_to_git_root"
}

main "$@"
